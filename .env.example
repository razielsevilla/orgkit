# Copy to .env.local and fill in. Never commit .env.local or real values.
# Rules: "Required" means the feature or the app fails without it. Optional values
# keep the default shown when left empty. A rate-limit value that is not a positive
# whole number is ignored and the default is used.

# --- Supabase (required) ---
# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# The project's anon (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key that bypasses row level security. Never expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- App address ---
# Public address of the app, for example https://orgkit.example. Join, invite, pay
# and check-in links, QR codes and reminder emails are built from it.
# Required in production, and read at build time: set it before `next build`, and
# rebuild after changing it. Outside production it falls back to localhost.
NEXT_PUBLIC_SITE_URL=

# --- Member join ---
# Contact shown in the member consent text and on /privacy. The public join page
# stays closed until this is a valid email
PRIVACY_CONTACT_EMAIL=

# --- Check-in ---
# Required for check-in: key that signs the rotating QR tokens, with no fallback.
# Generate one with: openssl rand -base64 32
CHECKIN_TOKEN_SECRET=

# --- Payment reminders (Resend) ---
# Required in production: API key for sending reminder emails. Without it, sending
# fails with a clear error. In development an in-memory mock is used instead
RESEND_API_KEY=
# Sender address on a domain verified in Resend. Default: OrgKit Reminders <onboarding@resend.dev>,
# which Resend only delivers to your own account, so set this in production
RESEND_FROM_EMAIL=

# --- Rate limiting (per device, per minute) ---
# Secret used to hash IP addresses before they are stored. Falls back to
# SUPABASE_SERVICE_ROLE_KEY. In production, one of the two must be set
JOIN_RATE_LIMIT_SECRET=
# Join attempts allowed per device per minute (default 30)
JOIN_ATTEMPTS_PER_MINUTE=
# Invite page opens allowed per device per minute (default 20)
INVITE_ATTEMPTS_PER_MINUTE=
# Member check-in attempts allowed per device per minute (default 30)
CHECKIN_ATTEMPTS_PER_MINUTE=
# Dues payment submissions allowed per device per minute (default 30)
DUES_PAY_ATTEMPTS_PER_MINUTE=
# In-app feedback messages allowed per device per minute (default 5)
FEEDBACK_ATTEMPTS_PER_MINUTE=
