NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# A4: member join
# Public address of the app, used to build join links and QR codes
NEXT_PUBLIC_SITE_URL=
# Contact shown in the member consent text (privacy contact email)
PRIVACY_CONTACT_EMAIL=
# Required for check-in: key that signs the rotating QR tokens. Generate one with: openssl rand -base64 32
CHECKIN_TOKEN_SECRET=
# Optional: secret for hashing IPs in join rate limiting (defaults to the service role key)
JOIN_RATE_LIMIT_SECRET=
# Optional: attempts allowed per device per minute (defaults: join 30, invite page 20)
JOIN_ATTEMPTS_PER_MINUTE=
INVITE_ATTEMPTS_PER_MINUTE=
# Optional: check-in attempts allowed per device per minute (default 30)
CHECKIN_ATTEMPTS_PER_MINUTE=
